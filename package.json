{
  "name": "caoa-venda-cantada-dash",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "scripts": {
    "dev": "pnpm --filter caoa-venda-cantada-web dev",
    "dev:backend": "pnpm --filter caoa-venda-cantada-api dev",
    "build": "pnpm --filter caoa-venda-cantada-web build",
    "build:backend": "pnpm --filter caoa-venda-cantada-api build",
    "start": "pnpm --filter caoa-venda-cantada-web start",
    "lint": "pnpm --filter caoa-venda-cantada-web lint",
    "db:seed": "pnpm --dir backend db:seed",
    "db:studio": "pnpm --dir backend db:studio",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.production down"
  }
}
