# Desenvolvimento local usa o banco remoto de homologação. Nunca use
# credenciais ou o banco de produção neste arquivo.
DATABASE_PROVIDER=sqlserver
APP_ENV=development
DATABASE_URL="sqlserver://SERVIDOR\\INSTANCIA;database=salesdb_hml;user=USUARIO;password={SENHA};encrypt=true;trustServerCertificate=true"
DATABASE_POOL_TIMEOUT_SECONDS=60
DATABASE_CONNECT_TIMEOUT_SECONDS=30
PORT=4000
BACKEND_AUTH_SECRET=defina-um-segredo-local-compartilhado-com-o-frontend
