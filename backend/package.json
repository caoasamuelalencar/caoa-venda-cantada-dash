{
  "name": "caoa-venda-cantada-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-development.mjs ./node_modules/.bin/ts-node-dev --transpile-only --no-notify --respawn src/server.ts",
    "dev:prisma:push": "node scripts/run-development.mjs ./node_modules/.bin/prisma db push",
    "dev:studio": "node scripts/run-development.mjs ./node_modules/.bin/prisma studio",
    "dev:seed": "node scripts/run-development.mjs ./node_modules/.bin/tsx prisma/seed.ts",
    "dev:rbac:seed": "node scripts/run-development.mjs ./node_modules/.bin/tsx prisma/seed-authorization.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "pnpm prisma:migrate:deploy",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:studio": "pnpm dev:studio",
    "db:seed": "pnpm prisma:generate && pnpm dev:seed",
    "db:catalog:changan": "node scripts/run-development.mjs ./node_modules/.bin/tsx prisma/seed-changan.ts",
    "rbac:seed": "pnpm dev:rbac:seed",
    "prod:rbac:seed": "tsx prisma/seed-authorization.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.17",
    "@types/node": "^20.14.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "supertest": "^7.3.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^3.5.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
