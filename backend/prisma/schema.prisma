generator client {
  provider = "prisma-client-js"
}

// Prisma requires the datasource provider to be chosen at schema/migration time.
// Keep this value aligned with the database you target for the current deployment.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SalesIntention {
  id               Int      @id @default(autoincrement())
  proprietario     String
  tipoVenda        String
  bandeira         String
  lojaVenda        String
  marcaVeiculo     String
  versao           String
  classificacao    String
  quantidade       Int
  dataSolicitacao  DateTime
  ano_fabricacao   Int?
  ano_modelo       Int?
  placa            String
  regional         String
  criado           DateTime @default(now())
}

model SalesIntentionCatalog {
  id            Int      @id @default(autoincrement())
  tipoVenda     String
  bandeira      String
  regional      String
  lojaVenda     String
  marcaVeiculo  String
  versao        String
  classificacao String
  criado        DateTime @default(now())
  atualizado    DateTime @updatedAt

  @@unique([tipoVenda, bandeira, regional, lojaVenda, marcaVeiculo, versao, classificacao])
  @@index([tipoVenda])
  @@index([bandeira])
  @@index([regional])
  @@index([marcaVeiculo])
}
