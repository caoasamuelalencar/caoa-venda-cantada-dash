generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model SalesIntention {
  id              Int       @id @default(autoincrement())
  proprietario    String?
  tipoVenda       String?
  bandeira        String?
  lojaVenda       String?
  marcaVeiculo    String?
  versao          String?
  classificacao   String?
  quantidade      Int?
  dataSolicitacao DateTime?
  ano_fabricacao  Int?
  ano_modelo      Int?
  placa           String?
  regional        String?
  criado          DateTime? @default(now())
  atualizado      String?   @db.NVarChar(50)

  @@index([dataSolicitacao])
}

model SalesIntentionCatalog {
  id              Int       @id @default(autoincrement())
  tipoVenda       String?
  bandeira        String?
  regional        String?
  lojaVenda       String?
  marcaVeiculo    String?
  versao          String?
  classificacao   String?
  criado          DateTime? @default(now())
  atualizado      DateTime? @updatedAt
  proprietario    String?   @db.VarChar(50)
  quantidade      String?   @db.VarChar(50)
  dataSolicitacao String?   @db.VarChar(50)
  placa           String?   @db.VarChar(50)
  ano_fabricacao  String?   @db.VarChar(50)
  ano_modelo      String?   @db.VarChar(50)

  @@index([tipoVenda])
  @@index([bandeira])
  @@index([regional])
  @@index([marcaVeiculo])
}

model SalesIntentionOptionCombination {
  id            Int      @id @default(autoincrement())
  combinationKey String   @unique @db.VarChar(64)
  tipoVenda     String   @db.NVarChar(30)
  bandeira      String   @db.NVarChar(100)
  regional      String   @db.NVarChar(100)
  lojaVenda     String   @db.NVarChar(200)
  marcaVeiculo  String   @db.NVarChar(100)
  versao        String   @db.NVarChar(200)
  classificacao String   @db.NVarChar(100)
  criado        DateTime @default(now())
  atualizado    DateTime @updatedAt

  @@index([tipoVenda, bandeira, regional])
}
