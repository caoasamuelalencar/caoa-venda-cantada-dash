# Arquivo de ambiente para a execucao nativa de homologacao.
# Copie para .env.homolog somente na VM de HML ou em um local seguro.
# Nunca versione o arquivo real nem seus valores.

DATABASE_PROVIDER=sqlserver
APP_ENV=homolog
DATABASE_URL="sqlserver://SERVIDOR:PORTA;database=salesdb_hml;user=USUARIO;password={SENHA};encrypt=true;trustServerCertificate=true;"
DATABASE_CONNECT_TIMEOUT_SECONDS=30
DATABASE_POOL_TIMEOUT_SECONDS=60

PORT=4000
BACKEND_HOST=127.0.0.1
FRONTEND_PORT=3003
FRONTEND_HOST=127.0.0.1
TLS_ENABLED=false
FRONTEND_TLS_ENABLED=false
API_BASE_URL=http://127.0.0.1:4000

# Deve ser o mesmo valor no frontend/BFF e backend.
BACKEND_AUTH_SECRET=coloque_um_segredo_compartilhado_forte_aqui

# Use a URL HTTPS definitiva da homologacao. Nao use localhost na VM.
NEXTAUTH_URL=https://vendacantada-hml.caoa.com.br
NEXTAUTH_SECRET=coloque_um_segredo_nextauth_forte_aqui
AZURE_AD_CLIENT_ID=coloque_o_client_id_aqui
AZURE_AD_CLIENT_SECRET=coloque_o_client_secret_aqui
AZURE_AD_TENANT_ID=coloque_o_tenant_id_aqui
BACKEND_REQUEST_TIMEOUT_MS=30000
